---
/*
  The cast of a post, linking out to each character's sheet.

  Deliberately not CharacterCards: six full stat blocks at the foot of every
  session would out-weigh the session. This is the name, who they are, and a
  way through — the sheet lives one click away.
*/

import type { Character } from '../utils/collections';
import { characterUrl } from '../utils/collections';

interface Props {
  characters: Character[];
  heading?: string;
}

const { characters, heading = 'Characters' } = Astro.props;
---

{characters.length > 0 && (
  <section class="mx-auto max-w-[var(--container-prose)] px-6 pb-10">
    <h2 class="mb-4 font-sans text-[0.62rem] uppercase tracking-[0.24em] text-mist-500">
      {heading}
    </h2>

    <ul class="grid list-none grid-cols-2 gap-2 p-0 sm:grid-cols-3">
      {characters.map((c) => {
        const { sheet } = c.data;
        const subtitle = [sheet.ancestry, sheet.charClass]
          .filter(Boolean)
          .join(' · ');
        return (
          <li class="m-0 p-0">
            <a
              href={characterUrl(c)}
              class="group flex h-full flex-col rounded-md border border-void-700 px-3 py-2 no-underline transition hover:border-violet-500/60"
            >
              <span
                class:list={[
                  'font-pixel text-base text-glow-50 transition group-hover:text-violet-200',
                  sheet.dead && 'line-through decoration-spark-500/70',
                ]}
              >
                {sheet.name}
              </span>
              {subtitle && (
                <span class="font-sans text-[0.68rem] uppercase tracking-[0.12em] text-mist-500">
                  {subtitle}
                </span>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  </section>
)}
