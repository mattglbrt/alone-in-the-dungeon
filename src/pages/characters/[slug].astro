---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharacterCard from '../../components/CharacterCard.astro';
import PostCard from '../../components/PostCard.astro';
import OrnamentalDivider from '../../components/OrnamentalDivider.astro';
import { getCharacterPosts } from '../../utils/collections';

export async function getStaticPaths() {
  const characters = await getCollection('characters');
  const allSeries = await getCollection('series');
  return characters.map((character) => ({
    params: { slug: character.id },
    props: {
      character,
      series: allSeries.find((s) => s.id === character.data.series),
    },
  }));
}

const { character, series } = Astro.props;
const { sheet } = character.data;
const { Content } = await render(character);
const posts = await getCharacterPosts(character.id);

const subtitle = [sheet.ancestry, sheet.charClass].filter(Boolean).join(' · ');
const description = `${sheet.name}${subtitle ? `, ${subtitle}` : ''}${
  series ? ` — ${series.data.title}` : ''
}. Character sheet, backstory, and every session they appear in.`;

const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://aloneinthedungeon.com/' },
    { '@type': 'ListItem', position: 2, name: 'Characters', item: 'https://aloneinthedungeon.com/characters/' },
    { '@type': 'ListItem', position: 3, name: sheet.name },
  ],
};
---

<BaseLayout title={sheet.name} description={description} structuredData={breadcrumbData}>
  <nav aria-label="Breadcrumb" class="mx-auto max-w-3xl px-6 pt-8">
    <ol class="flex flex-wrap items-center justify-center gap-1.5 font-sans text-[0.62rem] uppercase tracking-[0.18em] text-mist-500">
      <li><a href="/" class="no-underline hover:text-violet-300 transition">Home</a></li>
      <li aria-hidden="true" class="text-void-600">›</li>
      <li><a href="/characters/" class="no-underline hover:text-violet-300 transition">Characters</a></li>
      <li aria-hidden="true" class="text-void-600">›</li>
      <li class="text-glow-200/70">{sheet.name}</li>
    </ol>
  </nav>

  <header class="mx-auto max-w-3xl px-6 pt-10 pb-10 text-center">
    {series && (
      <div class="mb-6 flex flex-wrap items-center justify-center gap-3 font-sans text-[0.62rem] uppercase tracking-[0.24em]">
        <a
          href={`/series/${series.id}/`}
          class="rounded-full border border-violet-600/50 px-3 py-1 text-violet-300 no-underline transition hover:border-violet-500 hover:text-violet-200"
        >
          {series.data.title}
        </a>
        {series.data.system && (
          <span class="text-azure-400/80">{series.data.system}</span>
        )}
      </div>
    )}

    {/* Name only — the card below restates ancestry, class and title, so
        repeating them here just doubles the same three words. */}
    <h1 class="font-pixel text-4xl leading-tight text-glow-50 md:text-5xl">
      {sheet.name}
    </h1>

    <OrnamentalDivider class="mx-auto mt-10 w-44 text-violet-500" />
  </header>

  {/* Backstory, written in the MDX body. Who they are before what they roll. */}
  <div class="prose-body mx-auto max-w-[var(--container-prose)] px-6 pb-10">
    <Content />
  </div>

  {/* The sheet, dropped straight in — same component the session posts use. */}
  <section class="mx-auto max-w-md px-6 pb-14">
    <CharacterCard {...sheet} />
  </section>

  <section class="relative mx-auto max-w-6xl px-6 pb-24">
    <h2 class="heading-rule-left mb-8 font-pixel text-xl text-glow-50">
      Appears In
      {posts.length > 0 && (
        <span class="ml-3 font-sans text-sm font-normal text-mist-500">({posts.length})</span>
      )}
    </h2>
    {posts.length > 0 ? (
      <div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((p, i) => <PostCard post={p} eager={i < 3} />)}
      </div>
    ) : (
      <p class="font-reading text-lg italic text-glow-200/70">
        No sessions yet. {sheet.name} is waiting for the torch to be lit.
      </p>
    )}
  </section>
</BaseLayout>
